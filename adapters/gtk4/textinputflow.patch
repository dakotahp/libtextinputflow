diff -ruN a/gtk/gtktextinputflow.c b/gtk/gtktextinputflow.c
--- a/gtk/gtktextinputflow.c	1969-12-31 16:00:00.000000000 -0800
+++ b/gtk/gtktextinputflow.c	2026-10-28 09:19:14.166682163 -0700
@@ -0,0 +1,262 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include "config.h"
+
+#include "gtktextinputflowprivate.h"
+
+#include "gtkeditable.h"
+#include "gtkenums.h"
+#include "gtkeventcontroller.h"
+#include "gtkeventcontrollerkey.h"
+#include "gtkroot.h"
+#include "gtkshortcut.h"
+#include "gtkshortcutaction.h"
+#include "gtkshortcutcontroller.h"
+#include "gtkshortcuttrigger.h"
+#include "gtktextprivate.h"
+#include "gtktextviewprivate.h"
+
+#include <glib-unix.h>
+#include <textinputflow.h>
+
+static tif_ctx *bindings;
+static GListStore *shortcuts;
+
+static gboolean
+swallow_key (GtkWidget *widget,
+             GVariant  *args,
+             gpointer   user_data)
+{
+  return TRUE;
+}
+
+static gboolean
+select_all (GtkWidget *widget,
+            GVariant  *args,
+            gpointer   user_data)
+{
+  if (GTK_IS_TEXT_VIEW (widget))
+    g_signal_emit_by_name (widget, "select-all", TRUE);
+  else
+    gtk_editable_select_region (GTK_EDITABLE (widget), 0, -1);
+
+  return TRUE;
+}
+
+static GdkModifierType
+modifiers_for (uint32_t mods)
+{
+  GdkModifierType result = 0;
+
+  if (mods & TIF_MOD_SHIFT)
+    result |= GDK_SHIFT_MASK;
+  if (mods & TIF_MOD_CONTROL)
+    result |= GDK_CONTROL_MASK;
+  if (mods & TIF_MOD_ALT)
+    result |= GDK_ALT_MASK;
+  if (mods & TIF_MOD_SUPER)
+    result |= GDK_SUPER_MASK;
+
+  return result;
+}
+
+static uint32_t
+key_mods_for (GdkModifierType state)
+{
+  uint32_t result = 0;
+
+  if (state & GDK_SHIFT_MASK)
+    result |= TIF_MOD_SHIFT;
+  if (state & GDK_CONTROL_MASK)
+    result |= TIF_MOD_CONTROL;
+  if (state & GDK_ALT_MASK)
+    result |= TIF_MOD_ALT;
+  if (state & GDK_SUPER_MASK)
+    result |= TIF_MOD_SUPER;
+
+  return result;
+}
+
+static GtkMovementStep
+movement_step_for (tif_unit unit)
+{
+  switch (unit)
+    {
+    case TIF_UNIT_CHARACTER:
+      return GTK_MOVEMENT_VISUAL_POSITIONS;
+    case TIF_UNIT_WORD:
+      return GTK_MOVEMENT_WORDS;
+    case TIF_UNIT_LINE_ENDS:
+      return GTK_MOVEMENT_DISPLAY_LINE_ENDS;
+    case TIF_UNIT_DOCUMENT_ENDS:
+    case TIF_UNIT_NONE:
+    default:
+      return GTK_MOVEMENT_BUFFER_ENDS;
+    }
+}
+
+static GtkShortcutAction *
+action_for (const tif_command  *command,
+            GVariant          **args)
+{
+  *args = NULL;
+
+  if (command->action == TIF_ACTION_MOVE)
+    {
+      *args = g_variant_new ("(iib)",
+                             movement_step_for (command->unit),
+                             command->direction,
+                             command->extend);
+      return gtk_signal_action_new ("move-cursor");
+    }
+
+  if (command->action == TIF_ACTION_DELETE &&
+      command->unit == TIF_UNIT_CHARACTER &&
+      command->direction == TIF_DIRECTION_BACKWARD)
+    return gtk_signal_action_new ("backspace");
+
+  if (command->action == TIF_ACTION_DELETE)
+    {
+      *args = g_variant_new ("(ii)",
+                             command->unit == TIF_UNIT_WORD ? GTK_DELETE_WORD_ENDS : GTK_DELETE_CHARS,
+                             command->direction);
+      return gtk_signal_action_new ("delete-from-cursor");
+    }
+
+  return gtk_callback_action_new (select_all, NULL, NULL);
+}
+
+static GtkShortcut *
+shortcut_for (const tif_binding *binding)
+{
+  GtkShortcutTrigger *trigger;
+  GtkShortcutAction *action;
+  GVariant *args = NULL;
+  GtkShortcut *shortcut;
+
+  trigger = gtk_keyval_trigger_new (binding->key.keysym, modifiers_for (binding->key.mods));
+
+  if (binding->blocked)
+    action = gtk_callback_action_new (swallow_key, NULL, NULL);
+  else
+    action = action_for (&binding->command, &args);
+
+  shortcut = gtk_shortcut_new (trigger, action);
+  if (args)
+    gtk_shortcut_set_arguments (shortcut, args);
+
+  return shortcut;
+}
+
+static void
+fill_shortcuts (void)
+{
+  size_t count = tif_binding_count (bindings);
+  GPtrArray *items = g_ptr_array_new_full (count, g_object_unref);
+  tif_binding binding;
+
+  for (size_t i = 0; i < count; i++)
+    {
+      if (tif_binding_at (bindings, i, &binding))
+        g_ptr_array_add (items, shortcut_for (&binding));
+    }
+
+  g_list_store_splice (shortcuts,
+                       0, g_list_model_get_n_items (G_LIST_MODEL (shortcuts)),
+                       items->pdata, items->len);
+  g_ptr_array_unref (items);
+}
+
+static gboolean
+bindings_may_have_changed (int          fd,
+                           GIOCondition condition,
+                           gpointer     user_data)
+{
+  if (tif_refresh (bindings))
+    fill_shortcuts ();
+
+  return G_SOURCE_CONTINUE;
+}
+
+void
+gtk_text_input_flow_attach (GtkWidget *widget)
+{
+  GtkEventController *controller;
+
+  if (shortcuts == NULL)
+    {
+      bindings = tif_new ();
+      shortcuts = g_list_store_new (GTK_TYPE_SHORTCUT);
+      fill_shortcuts ();
+      if (tif_fd (bindings) != -1)
+        g_unix_fd_add (tif_fd (bindings), G_IO_IN, bindings_may_have_changed, NULL);
+    }
+
+  controller = gtk_shortcut_controller_new_for_model (G_LIST_MODEL (shortcuts));
+  gtk_event_controller_set_static_name (controller, "gtk-textinputflow");
+  gtk_widget_add_controller (widget, controller);
+}
+
+static gboolean
+has_preedit (GtkWidget *focus)
+{
+  if (GTK_IS_TEXT (focus))
+    return gtk_text_has_preedit (GTK_TEXT (focus));
+
+  return gtk_text_view_has_preedit (GTK_TEXT_VIEW (focus));
+}
+
+static gboolean
+window_key_pressed (GtkEventControllerKey *controller,
+                    guint                  keyval,
+                    guint                  keycode,
+                    GdkModifierType        state,
+                    gpointer               user_data)
+{
+  GtkWidget *window = gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (controller));
+  GtkWidget *focus = gtk_root_get_focus (GTK_ROOT (window));
+  tif_key key = { keyval, key_mods_for (state) };
+  tif_command command;
+  GtkShortcutAction *action;
+  GVariant *args;
+
+  if (gtk_window_get_application (GTK_WINDOW (window)) == NULL)
+    return FALSE;
+
+  if (!GTK_IS_TEXT (focus) && !GTK_IS_TEXT_VIEW (focus))
+    return FALSE;
+
+  /* This controller runs before the input method. It must leave keys alone
+   * while preedit text shows, or input method composition breaks. */
+  if (has_preedit (focus))
+    return FALSE;
+
+  if (tif_lookup (bindings, key, &command) != TIF_LOOKUP_COMMAND)
+    return FALSE;
+
+  action = action_for (&command, &args);
+  if (args)
+    g_variant_ref_sink (args);
+  gtk_shortcut_action_activate (action, GTK_SHORTCUT_ACTION_EXCLUSIVE, focus, args);
+  g_clear_pointer (&args, g_variant_unref);
+  g_object_unref (action);
+
+  return TRUE;
+}
+
+void
+gtk_text_input_flow_attach_window (GtkWindow *window)
+{
+  GtkEventController *controller;
+
+  controller = g_object_get_data (G_OBJECT (window), "gtk-textinputflow-window");
+  if (controller)
+    gtk_widget_remove_controller (GTK_WIDGET (window), controller);
+
+  controller = gtk_event_controller_key_new ();
+  gtk_event_controller_set_propagation_phase (controller, GTK_PHASE_CAPTURE);
+  gtk_event_controller_set_static_name (controller, "gtk-textinputflow-window");
+  g_signal_connect (controller, "key-pressed", G_CALLBACK (window_key_pressed), NULL);
+  g_object_set_data (G_OBJECT (window), "gtk-textinputflow-window", controller);
+  gtk_widget_add_controller (GTK_WIDGET (window), controller);
+}
